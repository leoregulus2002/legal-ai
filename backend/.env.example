APP_NAME=legal-ai
APP_ENV=development
DEBUG=true
# 仅本地开发示例；部署时替换凭据，密码中的保留字符需 URL 编码。
# 对应 infra 中的 pgvector/PostgreSQL 18 和 Redis 8；调整映射端口时同步更新 URL。
DATABASE_URL=postgresql+psycopg://legal_ai:local_dev_only@127.0.0.1:5432/legal_ai
REDIS_URL=redis://:local_redis_only@127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 配置加密主密钥（Fernet）；填写自己生成的值，不要提交到 Git。
# 生成命令见 README；模型、提示词、API Key 等业务配置在页面保存至数据库。
# CONFIG_ENCRYPTION_KEY=
ATTACHMENT_DIRECTORY=./data/attachments
